<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all" />
        <PackageReference Include="Google.Protobuf" Version="3.35.1"/>
        <PackageReference Include="Grpc.Tools" Version="2.82.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="MethodBoundaryAspect.Fody" Version="2.0.150" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="..\..\..\shared\proto\common.proto"
                  GrpcServices="None"
                  ProtoRoot="..\..\..\shared\proto"/>
        <Protobuf Include="..\..\..\shared\proto\services\declarative_memory.proto"
                  GrpcServices="None"
                  ProtoRoot="..\..\..\shared\proto"/>
        <Protobuf Include="..\..\..\shared\proto\services\neuro_core.proto"
                  GrpcServices="None"
                  ProtoRoot="..\..\..\shared\proto"/>
        <Protobuf Include="..\..\..\shared\proto\services\procedural_memory.proto"
                  GrpcServices="None"
                  ProtoRoot="..\..\..\shared\proto"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Harness.Shared\Harness.Shared.csproj" />
    </ItemGroup>

</Project>
